{
  "mcpServers": {
    "tavily-backup": {
      "args": [
        "-y",
        "tavily-mcp@latest"
      ],
      "command": "npx",
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "tavily-primary": {
      "args": [
        "-y",
        "tavily-mcp@latest"
      ],
      "command": "npx",
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  }
}
