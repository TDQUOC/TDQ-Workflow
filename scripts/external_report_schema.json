{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TDQ external report (task | plan)",
  "oneOf": [
    {
      "title": "task report",
      "type": "object",
      "required": ["task_id", "status", "files_changed", "test_cmd", "test_result", "notes"],
      "properties": {
        "kind": {"type": "string", "enum": ["task"]},
        "task_id": {"type": "string"},
        "status": {"type": "string", "enum": ["done", "blocked"]},
        "files_changed": {"type": "array", "items": {"type": "string"}},
        "test_cmd": {"type": "string"},
        "test_result": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    {
      "title": "plan report",
      "type": "object",
      "required": ["kind", "status", "tasks", "notes"],
      "properties": {
        "kind": {"type": "string", "enum": ["plan"]},
        "status": {"type": "string", "enum": ["done", "blocked"]},
        "notes": {"type": "string"},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["task_id", "status", "files_changed", "test_cmd", "test_result", "notes"],
            "properties": {
              "task_id": {"type": "string"},
              "status": {"type": "string", "enum": ["done", "blocked"]},
              "files_changed": {"type": "array", "items": {"type": "string"}},
              "test_cmd": {"type": "string"},
              "test_result": {"type": "string", "minLength": 1},
              "notes": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
