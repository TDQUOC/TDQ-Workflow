ion": 1, "versionNonce": 1513829113, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-head0", "type": "text", "x": 120, "y": 786, "width": 173.0798797607422, "height": 25, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3Q", "roundness": null, "seed": 1223786807, "version": 1, "versionNonce": 1619023127, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "text": "Vấn đề giải quyết", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Vấn đề giải quyết", "autoResize": true, "lineHeight": 1.25, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-body0", "type": "text", "x": 120, "y": 824, "width": 603.284423828125, "height": 75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3R", "roundness": null, "seed": 432771513, "version": 1, "versionNonce": 640445401, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "text": "Agent thường nhảy vào sửa code khi yêu cầu còn mơ hồ → phải làm lại nhiều lần.\ntdq-workflow bắt buộc: phân tích kỹ → interview đến khi hết mơ hồ → spec & plan\ntiếng Việt → NGƯỜI DÙNG duyệt bằng chat thường → mới được sửa code → QC lặp\nđến khi pass → report ≤ 50 dòng.", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Agent thường nhảy vào sửa code khi yêu cầu còn mơ hồ → phải làm lại nhiều lần.\ntdq-workflow bắt buộc: phân tích kỹ → interview đến khi hết mơ hồ → spec & plan\ntiếng Việt → NGƯỜI DÙNG duyệt bằng chat thường → mới được sửa code → QC lặp\nđến khi pass → report ≤ 50 dòng.", "autoResize": true, "lineHeight": 1.25, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-card1", "type": "rectangle", "x": 1380, "y": 770, "width": 1240, "height": 220, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#fff9db", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3S", "roundness": {"type": 3}, "seed": 1740259927, "version": 1, "versionNonce": 1912838711, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-head1", "type": "text", "x": 1400, "y": 786, "width": 150.75991821289062, "height": 25, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3T", "roundness": null, "seed": 969077401, "version": 1, "versionNonce": 1430489273, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "text": "Đối tượng dùng", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Đối tượng dùng", "autoResize": true, "lineHeight": 1.25, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-body1", "type": "text", "x": 1400, "y": 824, "width": 564.5695190429688, "height": 75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3U", "roundness": null, "seed": 1846402935, "version": 1, "versionNonce": 958479191, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "text": "Dev dùng Claude Code muốn agent làm đúng ngay lần implement đầu.\nTừ 0.3.0 bộ instruction viết theo hướng bước đánh số + mốc \"Xong khi:\"\n+ con trỏ \"Bước kế tiếp:\", để cả model nhỏ chạy local cũng đi đúng workflow,\nkhông phải đoán.", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Dev dùng Claude Code muốn agent làm đúng ngay lần implement đầu.\nTừ 0.3.0 bộ instruction viết theo hướng bước đánh số + mốc \"Xong khi:\"\n+ con trỏ \"Bước kế tiếp:\", để cả model nhỏ chạy local cũng đi đúng workflow,\nkhông phải đoán.", "autoResize": true, "lineHeight": 1.25, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-card2", "type": "rectangle", "x": 100, "y": 1020, "width": 1240, "height": 220, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3V", "roundness": {"type": 3}, "seed": 702232441, "version": 1, "versionNonce": 1361316249, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-head2", "type": "text", "x": 120, "y": 1036, "width": 131.29986572265625, "height": 25, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3W", "roundness": null, "seed": 1580259479, "version": 1, "versionNonce": 1244510327, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "text": "Giá trị cốt lõi", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Giá trị cốt lõi", "autoResize": true, "lineHeight": 1.25, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-body2", "type": "text", "x": 120, "y": 1074, "width": 589.814453125, "height": 93.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3X", "roundness": null, "seed": 2086133849, "version": 1, "versionNonce": 50425465, "isDeleted": false, "boundElements": null, "updated": 1786513617167, "link": null, "locked": false, "text": "· Duyệt bằng chat thường (\"duyệt spec\"), state lưu NGUYÊN VĂN câu bạn nói.\n· Hook NHẮC bằng mã [TDQ:*], không chặn tool — chỉ working log là điểm chặn.\n· Verify-by-effect: hook không tin lời agent, đối chiếu hiệu ứng thật trên đĩa\n  (sha256 working log + vân tay git status/diff đầu và cuối turn).\n· Hai lane: quick (việc nhỏ, rõ) và full (6 pha đầy đủ).", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "· Duyệt bằng chat thường (\"duyệt spec\"), state lưu NGUYÊN VĂN câu bạn nói.\n· Hook NHẮC bằng mã [TDQ:*], không chặn tool — chỉ working log là điểm chặn.\n· Verify-by-effect: hook không tin lời agent, đối chiếu hiệu ứng thật trên đĩa\n  (sha256 working log + vân tay git status/diff đầu và cuối turn).\n· Hai lane: quick (việc nhỏ, rõ) và full (6 pha đầy đủ).", "autoResize": true, "lineHeight": 1.25, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch1-card3", "type": "rectangl