21.825Z"}, {"id": "ch10-e003", "type": "text", "x": 309.901298449528, "y": 14842.435168961203, "width": 254.474609375, "height": 16.099999999999998, "angle": 0, "strokeColor": "#c5f6fa", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3B", "roundness": null, "seed": 1614315833, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "text": "Build trên gì · test ra sao · vì sao đáng tin", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Build trên gì · test ra sao · vì sao đáng tin", "autoResize": true, "lineHeight": 1.15, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch10-e004", "type": "rectangle", "x": 280.098701550472, "y": 14878.435168961203, "width": 760, "height": 555, "angle": 0, "strokeColor": "#f8f9fa", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3C", "roundness": null, "seed": 1047923415, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch10-e005", "type": "text", "x": 309.901298449528, "y": 14896.435168961203, "width": 153.6591796875, "height": 20.7, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3D", "roundness": null, "seed": 333836825, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "text": "Nền tảng xây dựng", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Nền tảng xây dựng", "autoResize": true, "lineHeight": 1.15, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch10-e006", "type": "text", "x": 310.098701550472, "y": 14930.435168961203, "width": 156.4267578125, "height": 321.99999999999994, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3E", "roundness": null, "seed": 2067568631, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "text": "• tdq_state.py — Python\n  thuần, state machine\n  JSON, không phụ thuộc\n  framework ngoài\n\n• Claude Code plugin:\n  skills (SKILL.md) +\n  hooks chạy mỗi turn\n\n• doc_lint.py — validator\n  spec/plan, đối chiếu\n  spec ↔ plan tự động\n\n• graphify — sinh code\n  graph sau mỗi lần\n  đổi code\n\n• portable/ — bản thuần\n  Markdown, chạy cả\n  ngoài Claude Code", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• tdq_state.py — Python\n  thuần, state machine\n  JSON, không phụ thuộc\n  framework ngoài\n\n• Claude Code plugin:\n  skills (SKILL.md) +\n  hooks chạy mỗi turn\n\n• doc_lint.py — validator\n  spec/plan, đối chiếu\n  spec ↔ plan tự động\n\n• graphify — sinh code\n  graph sau mỗi lần\n  đổi code\n\n• portable/ — bản thuần\n  Markdown, chạy cả\n  ngoài Claude Code", "autoResize": true, "lineHeight": 1.15, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch10-e007", "type": "text", "x": 669.901298449528, "y": 14896.435168961203, "width": 161.0771484375, "height": 20.7, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3F", "roundness": null, "seed": 1450329849, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "text": "Test & Development", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Test & Development", "autoResize": true, "lineHeight": 1.15, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch10-e008", "type": "text", "x": 669.901298449528, "y": 14930.435168961203, "width": 164.2060546875, "height": 321.99999999999994, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b3G", "roundness": null, "seed": 905216279, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "text": "• pytest cho toàn bộ\n  hook + state logic\n  (edit_gate, stop_gate,\n  turn_snapshot, plan_tick)\n\n• TDD bắt buộc — viết\n  test trước, red→green,\n  tick ngay khi pass\n\n• QC 2 lớp: pytest +\n  đối chiếu DoD nghiệp\n  vụ trước khi report\n\n• State logic tách khỏi\n  hook/UI → test nhanh,\n  không cần mock harness\n\n• Working log + report\n  = audit trail, dễ\n  review quyết định", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• pytest cho toàn bộ\n  hook + state logic\n  (edit_gate, stop_gate,\n  turn_snapshot, plan_tick)\n\n• TDD bắt buộc — viết\n  test trước, red→green,\n  tick ngay khi pass\n\n• QC 2 lớp: pytest +\n  đối chiếu DoD nghiệp\n  vụ trước khi report\n\n• State logic tách khỏi\n  hook/UI → test nhanh,\n  không cần mock harness\n\n• Working log + report\n  = audit trail, dễ\n  review quyết định", "autoResize": true, "lineHeight": 1.15, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch10-e009", "type": "rec