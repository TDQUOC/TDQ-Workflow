keColor": "#1e1e1e"}, {"id": "ch7-a053", "type": "arrow", "x": 370.0, "y": 11252.435168961203, "points": [[0, 0], [193.33333333333337, 0]], "width": 193.33333333333337, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t054", "type": "text", "x": 376.0, "y": 11280.435168961203, "width": 164.24, "height": 18.900000000000002, "text": "18. set phase=idle", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"id": "ch7-a055", "type": "arrow", "x": 370.0, "y": 11300.435168961203, "points": [[0, 0], [386.66666666666674, 0]], "width": 386.66666666666674, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t056", "type": "text", "x": 182.66666666666669, "y": 11328.435168961203, "width": 146.88, "height": 18.900000000000002, "text": "19. Báo hoàn tất", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"id": "ch7-a057", "type": "arrow", "x": 370.0, "y": 11348.435168961203, "points": [[0, 0], [-193.33333333333331, 0]], "width": 193.33333333333331, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t058", "type": "text", "x": 80, "y": 11406.435168961203, "width": 1160, "height": 64.80000000000001, "text": "Mỗi mũi tên là một lần agent gọi ra ngoài hoặc hook chạy. Hai điểm\nngười dùng phải nhắn tay: bước 9 (duyệt spec) và bước 12 (duyệt\nplan kèm mode).", "fontSize": 16, "strokeColor": "#495057"}, {"id": "ch8-frame", "type": "rectangle", "x": 40, "y": 11631.235168961202, "width": 1240, "height": 1367.2000000000003, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0}, {"id": "ch8-title", "type": "text", "x": 80, "y": 11657.235168961202, "width": 1160, "height": 40.5, "text": "8. Kiến trúc & cấu trúc thư mục", "fontSize": 30, "strokeColor": "#1971c2"}, {"id": "ch8-box001", "type": "rectangle", "x": 80, "y": 11721.235168961202, "width": 1160, "height": 98.6, "backgroundColor": "#e7f5ff", "strokeColor": "#1971c2", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "roundness": {"type": 3}}, {"id": "ch8-t002", "type": "text", "x": 100, "y": 11741.235168961202, "width": 1120, "height": 27.0, "text": "session_start.py", "fontSize": 20, "strokeColor": "#1971c2"}, {"id": "ch8-t003", "type": "text", "x": 100, "y": 11778.235168961202, "width": 1120, "height": 21.6, "text": "đầu session: in [TDQ:NEXT] — phase hiện tại + việc kế tiếp", "fontSize": 16, "strokeColor": "#1e1e1e"}, {"id": "ch8-box004", "type": "rectangle", "x": 80, "y": 11843.835168961203, "width": 1160, "height": 120.2, "backgroundColor": "#ebfbee", "strokeColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "roundness": {"type": 3}}, {"id": "ch8-t005", "type": "text", "x": 100, "y": 11863.835168961203, "width": 1120, "height": 27.0, "text": "prompt_context.py", "fontSize": 20, "strokeColor": "#2f9e44"}, {"id": "ch8-t006", "type": "text", "x": 100, "y": 11900.835168961203, "width": 1120, "height": 43.2, "text": "đầu mỗi turn: chèn trạng thái, chụp sha256 working log + vân tay\ngit", "fontSize": 16, "strokeColor": "#1e1e1e"}, {"id": "ch8-box007", "type": "rectangle", "x": 80, "y": 11988.035168961202, "width": 1160, "height": 120.2, "backgroundColor": "#fff9db", "strokeColor": "#e8590c", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "roundness": {"type": 3}}, {"id": "ch8-t008", "type": "text", "x": 100, "y": 12008.035168961202, "width": 1120, "height": 27.0, "text": "edit_gate.py", "fontSize": 20, "strokeColor": "#e8590c"}, {"id": "ch8-t009", "type": "text", "x": 100, "y": 12045.035168961202, "width": 1120, "height": 43.2, "text": "sửa file ngoài docs/ khi chưa duyệt → [TDQ:APPROVE]; ghi thẳng\nstate.json → [TDQ:STATE]", "fontSize": 16, "strokeColor": "#1e1e1e"}, {"id": "ch8-box010", "type": "rectangle", "x": 80, "y": 12132.235168961202, "width": 1160, "height": 120.2, "backgroundColor": "#f3f0ff", "strokeColor": "#6741d9", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "roundness": {"type": 3}}, {"id": "ch8-t011", "type": "text", "x": 100, "y": 12152.235168961202, "width": 1120, "height": 27.0, "text": "bash_gate.py", "fontSize": 20, "strokeColor": "#6741d9"}, {"id": "ch8-t012", "type": "text", "x": 100, "y": 12189.235168961202, "width": 1120, "height": 43.2, "text": "lệnh git commit/push/branch → [TDQ:GIT], kiểm quy ước tên và\nmessage", "fontSize": 16, "strokeColor": "#1e1e1e"}, {"id": "ch8-box013", "type": "rectangle", "x": 80, "y": 12276.435168961203, "width": 1160, "height": 120.2, "backgroundColor": "#ffe3e3", "strokeColor": "#c92a2a", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "roundness": {"type": 3}}, {"id": "ch8-t014", "type": "text", "x": 100, "y": 12296.435168961203, "width": 1120, "height": 27.0, "text": "stop_gate.py", "fontSize": 20, "strokeColor": "#c92a2a"}, {"id": "ch8-t015", "type": "text", "x": 100, "y": 12333.435168961203, "width": 1120, "height": 43.2, "text": "cuối turn: so vân tay đầu/cuối — có đổi repo mà chưa ghi log →\nCHẶN bằng [TDQ:LOG]", "fontSize": 16, "strokeColor": "#1e1e1e"}, {"id": "ch8-box016", "type": "rectangle", "x": 80, "y": 12420.635168961202, "width": 1160, "height": 120.2, "backgroundColor": "#e6fcf5", "strokeColor": "#0ca678", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "roundness": {"type": 3}}, {"id": "ch8-t017", "type": "text", "x": 100, "y": 12440.635168961202, "width": 1120, "height": 27.0, "text": "_common.py", "fontSize": 20, "strokeColor": "#0ca678"}, {"id": "ch8-t018", "type": "text", "x": 100, "y": 12477.635168961202, "width": 1120, "height": 43.2, "text": "hàm dùng chung: đọc state, chụp vân tay, ghi sổ turn\n.tdq-turn.jsonl", "fontSize": 16, "strokeColor": "#1e1e1e"}, {"id": "ch8-t019", "type": "text", "x": 80, "y": 12564.835168961203, "width": 1160, "height": 237.60000000000002, "text": "TDQWorkflow/\n├── .claude-plugin/plugin.json      tên + version plugin (0.11.2)\n├── hooks/                          hooks.json + 6 script Python\n│   └── scripts/  _common.py · bash_gate.py · edit_gate.py\n│               prompt_context.py · session_start.py · stop_gate.py\n├── scripts/                     11 script Python (0 package ngoài)\n├── skills/               6 skill: tdq-intake · tdq-spec · tdq-plan\n│                          tdq-build · tdq-status · tdq-conventions\n├── portable/             bản cho agent ngoài Claude Code (11 file)\n├── tests/                          unit test cho hook + script\n└── docs/tdq/       brief · spec · plan · qc · reports · state.json", "fontSize": 16, "strokeColor": "#495057"}, {"id": "ch8-t020", "type": "text", "x": 80, "y": 12826.435168961203, "width": 1160, "height": 21.6, "text": "6 hook script — điểm chặn duy nhất là working log", "fontSize": 16, "strokeColor": "#495057"}, {"id": "ch8-t021", "type": "text", "x": 80, "y": 12872.035168961203, "width": 1160, "height": 86.4, "text": "Luồng dữ liệu: hook chỉ ĐỌC/GHI docs/tdq/state.json qua\nscripts/tdq_state.py — cùng một CLI mà agent dùng, nên không có hai\nnguồn sự thật. Skill là văn bản hướng dẫn, không có mã chạy; mọi\nphép kiểm đo được đều nằm trong scripts/.", "fontSize": 16, "strokeColor": "#495057"}, {"id": "ch9-frame", "type": "rectangle", "x": 40, "y": 13118.435168961203, "width": 1240, "height": 1510.0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0}, {"id": "ch9-e000", "type": "rectangle", "x": 280.0, "y": 13158.435168961203, "width": 760, "height": 110, "angle": 0, "strokeColor": "#364fc7", "backgroundColor": "#364fc7", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "b2p", "roundness": null, "seed": 2077631671, "isDeleted": false, "boundElements": null, "link": null, "locked": false, "syncedAt": "2026-08-12T08:35:21.841Z", "source": "frontend_sync", "syncTimestamp": "2026-08-12T08:35:21.825Z"}, {"id": "ch9-title", "type": "text", "x": 310.0, "y": 13174.435168961203, "width": 269.7670898437