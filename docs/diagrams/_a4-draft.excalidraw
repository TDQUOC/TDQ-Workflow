0, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t034", "type": "text", "x": 182.66666666666669, "y": 10800.435168961203, "width": 216.32, "height": 18.900000000000002, "text": "8. Trình spec, chờ duyệt", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"id": "ch7-a035", "type": "arrow", "x": 370.0, "y": 10820.435168961203, "points": [[0, 0], [-193.33333333333331, 0]], "width": 193.33333333333331, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t036", "type": "text", "x": 182.66666666666669, "y": 10848.435168961203, "width": 138.2, "height": 18.900000000000002, "text": "9. \"duyệt spec\"", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"id": "ch7-a037", "type": "arrow", "x": 176.66666666666669, "y": 10868.435168961203, "points": [[0, 0], [193.33333333333331, 0]], "width": 193.33333333333331, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t038", "type": "text", "x": 376.0, "y": 10896.435168961203, "width": 146.88, "height": 18.900000000000002, "text": "10. approve spec", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"id": "ch7-a039", "type": "arrow", "x": 370.0, "y": 10916.435168961203, "points": [[0, 0], [386.66666666666674, 0]], "width": 386.66666666666674, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t040", "type": "text", "x": 376.0, "y": 10944.435168961203, "width": 181.6, "height": 18.900000000000002, "text": "11. Viết plan + mode", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"id": "ch7-a041", "type": "arrow", "x": 370.0, "y": 10964.435168961203, "points": [[0, 0], [580.0, 0]], "width": 580.0, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "roughness": 0}, {"id": "ch7-t042", "type": "text", "x": 182.66666666666669, "y": 10992.435168961203, "width": 190.28, "height": 18.900000000000002, "text": "12. duyệt plan + mode", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"id": "ch7-a043", "type": "arrow", "x": 176.6