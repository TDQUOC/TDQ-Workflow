  "cards": [
    {
      "dot": "cyan",
      "title": "Thiết kế chờ duyệt",
      "items": [
        "Chưa sửa mã runtime; sơ đồ mô tả hành vi đề xuất trong spec v1.0.",
        "Hai nhánh độc lập: xem/đóng timing và chạy kiểm thử.",
        "Lọc đúng project chưa chứng minh mọi phiên thuộc riêng request: tự dò ghi project_window."
      ]
    },
    {
      "dot": "amber",
      "title": "Đo đúng phạm vi",
      "items": [
        "API là khoảng host quan sát, không phải thời gian GPU. Codex thiếu mốc API thì chưa xác định.",
        "Tool trả job nền không có nghĩa job đã xong; thiếu mốc hoàn tất giữ quality chưa đầy đủ.",
        "Hợp khoảng chống cộng lặp; phần còn lại là chưa phân loại, không tự gọi là chờ user."
      ]
    },
    {
      "dot": "rose",
      "title": "Không làm mất lỗi",
      "items": [
        "Source direct rỗng: thử bắc cầu rồi fallback full; vẫn thiếu test → INCOMPLETE.",
        "No-op tài liệu → SKIP. Có lỗi → FAIL/ERROR; timeout, report hỏng hoặc chỉ skip không PASS.",
        "Giữ lỗi chưa ánh xạ; đọc XML pytest và đối chiếu exit code, không chỉ cắt chuỗi màn hình."
      ]
    },
    {
      "dot": "emerald",
      "title": "Nghiệm thu đợt 1",
      "items": [
        "QC Full: DoD + toàn unit suite + hồi quy vùng chạm + kiến trúc và clean code.",
        "Direct xanh chỉ chứng minh tập đã chạy; test gián tiếp đỏ phải bị bắt ở QC.",
        "Giữ lịch sử cũ và đóng sổ một lần; chưa tăng worker, tái dùng PASS hoặc hứa mức tăng tốc."
      ]
    }
  ]
