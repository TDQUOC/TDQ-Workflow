+        raw = path.read_bytes()
+        if hashlib.sha256(raw).hexdigest() != expected:
+            raise ValueError(f"source_hash_mismatch:{variant}:{name}")
+        contents.append(f"--- {name} ---\n{raw.decode('utf-8')}")
