+def _report_provenance(records: List[Dict[str, Any]]) -> str:
+    labels = {record.get("provenance") or "unavailable" for record in records}
+    if not labels:
+        return "unavailable"
+    return next(iter(labels)) if len(labels) == 1 else "mixed"
