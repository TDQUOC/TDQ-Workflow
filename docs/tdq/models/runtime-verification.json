    {
      "dot": "emerald",
      "title": "Chỉ reuse khi đủ điều kiện",
      "items": [
        "Reuse yêu cầu khai báo dependency gắn với source; case chưa rõ luôn chạy mới. Mọi lần lookup/join đều kiểm lại input hiện tại.",
        "Readiness chỉ lưu kiểm tra version/inventory tĩnh. Doctor, cấu hình và smoke check vẫn kiểm trực tiếp."
      ]
    },
    {
      "dot": "rose",
      "title": "Giới hạn của transcript cache",
      "items": [
        "Hash nội dung và kiểm lại log; lưu sự kiện chuẩn hóa rồi lọc, ghép và tính lại. Không lưu prompt/tool payload thô trong cache.",
        "Sơ đồ thể hiện dependency của source. Khuyến nghị tốc độ phải dựa trên benchmark và QC cuối."
      ]
    }
