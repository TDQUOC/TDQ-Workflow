{
  "description": "TDQ workflow cho Codex CLI — sinh tự động, không sửa tay",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"hooks/scripts/codex_edit_gate.py\"",
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "command": "python3 \"hooks/scripts/bash_gate.py\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"hooks/scripts/session_start.py\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"hooks/scripts/stop_gate.py\"",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"hooks/scripts/prompt_context.py\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}
